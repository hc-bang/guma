# ==============================================================================
# GUMA™ 환경 설정 예제 파일 (.env.example)
#
# [사용 방법]
# 1. 이 파일을 복사하여 같은 위치에 '.env' 파일로 이름을 변경합니다.
#    - Windows PowerShell: Copy-Item .env.example .env
#    - Linux / macOS bash: cp .env.example .env
# 2. 아래 DATABASE_URL에 본인의 Neon PostgreSQL 연결 문자열을 입력합니다.
# 3. .env 파일은 비밀번호가 포함되므로 Git에 커밋되지 않도록 주의하세요 (.gitignore에 자동 등록됨).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon Serverless PostgreSQL 연결 문자열 (필수 연동 시)
# ------------------------------------------------------------------------------
# - Neon 대시보드(https://console.neon.tech) 접속
# - 프로젝트(예: guma) 선택 -> [Dashboard] 화면의 [Connection Details] 확인
# - [Connection string] 드롭다운에서 'Postgres' 선택 후 전체 URI 복사
# - 형식: postgresql://[사용자명]:[비밀번호]@[호스트명]/[데이터베이스명]?sslmode=require
#
# (미설정 시 DB 연결 없이 기본 로컬 모드로 안전하게 작동합니다)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/guma?sslmode=require

# ------------------------------------------------------------------------------
# 2. 백엔드 서버 구동 환경 설정 (선택 사항)
# ------------------------------------------------------------------------------
# 백엔드 서비스 기본 포트 (기본값: 80)
PORT=80

# 백엔드 서비스 바인드 호스트 (기본값: 0.0.0.0)
HOST=0.0.0.0

# 로깅 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. GitHub Personal Access Token (터널 주소 자동 Git-Ops 배포용, 선택 사항)
# ------------------------------------------------------------------------------
# Cloudflare 터널 주소를 깃허브 Pages로 자동 커밋/푸시하기 위한 토큰입니다.
# repo 권한이 부여된 GitHub Personal Access Token(Classic)을 입력합니다.
GITHUB_TOKEN=ghp_your_github_token_here
